{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "StockForge",
  "version": "0.1.0",
  "identifier": "com.stockforge.dev",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "StockForge",
        "label": "main",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Offline Desktop Inventory & Sales Management System",
    "longDescription": "StockForge is a reliable offline-first desktop POS, inventory tracking, and sales analytics suite built with SQLite transaction safety, VAT compliance, multi-shop support, and local data persistence.",
    "copyright": "Copyright © 2026 StockForge. All rights reserved.",
    "publisher": "StockForge",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
